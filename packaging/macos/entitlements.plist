<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions DataBug needs (notarization requires the
  hardened runtime):
  - disable-library-validation: DataBug loads libraries signed by other
    developers at run time: DuckDB's official libduckdb, Oracle Instant
    Client and ODBC drivers.
  - allow-dyld-environment-variables: Oracle Instant Client and ODBC setups
    are often found through DYLD_LIBRARY_PATH.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
